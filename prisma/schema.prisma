// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @default(now()) @updatedAt
  username        String    @unique
  name            String
  email           String    @unique
  superuser       Boolean   @default(false)
  title           String
  description     String?
  hostname        String?   @unique
  license         String?
  googleAnalytics String?
  favicon         String?
  logo            String?
  viewport        String?
  sidebarHtml     String?
  theme           String
  magicKey        String
  privateKey      String

  // FEP-8b32 object integrity proofs, which sign the activity itself so it
  // survives being forwarded by a relay or another instance. Ed25519, because
  // the eddsa-jcs-2022 cryptosuite names the curve — the RSA key above signs
  // HTTP requests, and an HTTP signature dies at the first hop. Nullable:
  // accounts created before this get one provisioned on demand.
  ed25519PrivateKey String?

  // AT Protocol. atprotoSigningKey is a P-256 key for the did:web document —
  // the RSA key above can't serve as an atproto verification method. The
  // Bluesky app password and refresh token are stored in the clear, following
  // the same (poor) precedent as privateKey; worth encrypting at rest.
  atprotoDid        String?
  atprotoHandle     String?
  atprotoPdsUrl     String?
  atprotoAppPassword String?
  atprotoRefreshJwt String?
  atprotoSigningKey String?

  // A Mastodon (or any fediverse) profile to cross-verify with, via rel="me".
  // There is no credential here: Mastodon federates with this site directly.
  mastodonUrl       String?

  Content       Content[]
  ContentRemote ContentRemote[] @relation("toUser")
}

model UserRemote {
  id                  Int       @id @default(autoincrement())
  createdAt           DateTime? @default(now())
  updatedAt           DateTime? @default(now()) @updatedAt
  localUsername       String
  username            String
  name                String
  profileUrl          String
  feedUrl             String
  magicKey            String?
  // The peer's Ed25519 Multikey from their actor's assertionMethod, for
  // verifying FEP-8b32 proofs on activities that reach us second-hand.
  ed25519PublicKey    String?
  salmonUrl           String?
  activityPubActorUrl String?
  activityPubInboxUrl String?
  sharedInboxUrl      String?
  webmentionUrl       String?
  hubUrl              String?
  follower            Boolean   @default(false)
  following           Boolean   @default(false)
  avatar              String
  favicon             String?
  order               Int       @default(0)
  sortType            String?

  // A peer followed over AT Protocol instead of Atom/ActivityPub.
  atprotoDid          String?
  atprotoHandle       String?
  atprotoPdsUrl       String?

  @@index([localUsername])
  @@index([profileUrl])
  @@index([atprotoDid])
  @@unique([localUsername, profileUrl])
  @@unique([localUsername, activityPubActorUrl])
}

model Content {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @default(now()) @updatedAt
  user            User      @relation(fields: [username], references: [username])
  username        String
  section         String
  album           String
  name            String
  template        String?
  sortType        String?
  redirect        Int?
  hidden          Boolean   @default(false)
  title           String
  thumb           String
  order           Int       @default(0)
  count           Int       @default(0)
  countRobot      Int       @default(0)
  commentsCount   Int       @default(0)
  commentsUpdated DateTime?
  favoritesCount  Int       @default(0)
  thread          String?
  threadUser      String?
  avatar          String?
  style           String
  code            String
  view            String

  // Where this post was mirrored on the AT Protocol side, so edits and deletes
  // can find the record again.
  atprotoUri      String?
  atprotoCid      String?

  // TODO(mime): add full-text search?
  //@@index([title, view])
  @@unique([username, name])
  @@index([section])
  @@index([name])
  @@index([username])
  @@index([album])
}

model ContentRemote {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime? @default(now())
  updatedAt        DateTime? @default(now()) @updatedAt
  toUser           User      @relation(name: "toUser", fields: [toUsername], references: [username])
  toUsername       String
  localContentName String?
  fromUsername     String?
  fromUserRemoteId String?
  commentUser      String?
  username         String
  creator          String?
  avatar           String?
  title            String
  postId           String
  link             String
  commentsUpdated  DateTime?
  commentsCount    Int       @default(0)
  thread           String?
  type             String
  favorited        Boolean   @default(false)
  read             Boolean   @default(false)
  isSpam           Boolean   @default(false)
  deleted          Boolean   @default(false)
  view             String

  // TODO(mime): add full-text search?
  //@@index([title, view])
  @@index([toUsername])
  @@index([fromUsername])
  @@index([commentUser])
  @@index([toUsername, fromUsername])
  @@index([toUsername, commentUser])
  @@index([toUsername, postId])
  @@unique([toUsername, fromUsername, postId])
  @@unique([commentUser, postId])
  @@index([thread])
}
