{
  "name": "hello-world-blog",
  "version": "0.8.7",
  "description": "hello, world. a federated blog with feed reader.",
  "author": "Mime Čuvalo <mimecuvalo@gmail.com>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mimecuvalo/helloworld.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "bugs": {
    "url": "https://github.com/mimecuvalo/helloworld/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:local": "DATABASE_URL=postgresql://mime@localhost:5432/helloworld_dev DEV_LOGIN_EMAIL=mimecuvalo@gmail.com vite dev",
    "db:local:push": "DATABASE_URL=postgresql://mime@localhost:5432/helloworld_dev prisma db push --url postgresql://mime@localhost:5432/helloworld_dev",
    "db:bootstrap": "prisma generate && bun scripts/bootstrap.ts",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:extract": "formatjs extract 'routes/**/*.ts*' 'components/**/*.ts*' --out-file i18n/en.json --additional-component-names F --id-interpolation-pattern '[md5:contenthash:hex:10]' --flatten --format smartling",
    "i18n:compile": "formatjs compile-folder i18n i18n/compiled --format smartling --ast",
    "alex": "alex .",
    "config": "node scripts/config.js",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "test": "vitest",
    "test:ci": "vitest run",
    "type-check": "tsgo --noEmit"
  },
  "dependencies": {
    "@auth/core": "0.34.3",
    "@aws-sdk/client-s3": "3.864.0",
    "@aws-sdk/s3-presigned-post": "3.864.0",
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/oswald": "5.2.8",
    "@fontsource/marck-script": "5.2.8",
    "@fontsource/noto-color-emoji": "5.2.8",
    "@fontsource/press-start-2p": "5.2.7",
    "@hono/zod-validator": "0.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-icons": "1.3.2",
    "@sentry/tanstackstart-react": "10.63.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "@tiptap/extension-image": "3.2.0",
    "@tiptap/extensions": "3.2.0",
    "@tiptap/pm": "3.2.0",
    "@tiptap/react": "3.2.0",
    "@tiptap/starter-kit": "3.2.0",
    "cheerio": "1.1.0",
    "classnames": "2.5.1",
    "dataloader": "2.2.3",
    "feedparser": "2.2.10",
    "hono": "4.12.27",
    "intl-messageformat": "11.2.9",
    "js-cookie": "3.0.5",
    "lite-youtube-embed": "0.3.3",
    "lodash": "4.17.21",
    "magic-signatures": "2.0.0",
    "mime": "4.0.7",
    "nanoid": "5.1.5",
    "node-forge": "1.3.1",
    "node-schedule": "2.1.1",
    "pg": "8.22.0",
    "prisma": "7.8.0",
    "pubsubhubbub": "1.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-intl": "7.1.11",
    "react-masonry-css": "1.0.16",
    "sanitize-html": "2.17.0",
    "sanitize.css": "13.0.0",
    "swipe-listener": "1.3.0",
    "uuid": "11.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@formatjs/cli": "6.16.14",
    "@formatjs/unplugin": "1.2.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/feedparser": "2.2.8",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.20",
    "@types/mime": "4.0.0",
    "@types/node": "24.0.10",
    "@types/node-forge": "1.3.12",
    "@types/node-schedule": "2.1.7",
    "@types/pg": "8.20.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/sanitize-html": "2.16.0",
    "@types/uuid": "10.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.3",
    "alex": "11.0.1",
    "axe-core": "4.12.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.1.2",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "typescript": "5.8.3",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "oxfmt"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "bash -c 'bun run i18n:extract && bun run i18n:compile'"
    ],
    "prisma/schema.prisma": [
      "bun run prisma:generate"
    ]
  },
  "husky": {
    "hooks": {
      "post-checkout": "./scripts/post-checkout",
      "post-merge": "./scripts/post-merge"
    }
  },
  "browserslist": "last 2 versions",
  "sideEffects": false,
  "packageManager": "bun@1.3.2",
  "resolutions": {
    "prosemirror-model": "1.25.3"
  }
}
