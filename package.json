{
  "name": "hello-world-blog",
  "version": "0.8.7",
  "description": "hello, world. a federated blog with feed reader.",
  "author": "Mime Čuvalo <mimecuvalo@gmail.com>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mimecuvalo/helloworld.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1"
  },
  "bugs": {
    "url": "https://github.com/mimecuvalo/helloworld/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:local": "DATABASE_URL=postgresql://mime@localhost:5432/helloworld_dev DEV_LOGIN_EMAIL=mimecuvalo@gmail.com vite dev",
    "db:local:push": "DATABASE_URL=postgresql://mime@localhost:5432/helloworld_dev prisma db push --url postgresql://mime@localhost:5432/helloworld_dev",
    "db:bootstrap": "prisma generate && bun scripts/bootstrap.ts",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:extract": "formatjs extract 'app/routes/**/*.ts*' 'components/**/*.ts*' --out-file i18n/en.json --additional-component-names F --id-interpolation-pattern '[md5:contenthash:hex:10]' --flatten --format smartling",
    "i18n:compile": "formatjs compile-folder i18n i18n/compiled --format smartling --ast",
    "config": "node scripts/config.js",
    "encrypt-secrets": "bun scripts/encrypt-secrets.ts",
    "rotate-keys": "bun scripts/rotate-keys.ts",
    "rotate-keys:local": "DATABASE_URL=postgresql://mime@localhost:5432/helloworld_dev bun scripts/rotate-keys.ts",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "test": "vitest",
    "test:ci": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/api": "0.20.41",
    "@atproto/crypto": "0.5.4",
    "@auth/core": "0.41.3",
    "@aws-sdk/client-s3": "3.1093.0",
    "@aws-sdk/s3-presigned-post": "3.1093.0",
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource/marck-script": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@hono/zod-validator": "0.9.0",
    "@ipld/dag-cbor": "10.0.2",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@radix-ui/react-icons": "1.3.2",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tiptap/extension-emoji": "3.28.0",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/extensions": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@tiptap/suggestion": "3.28.0",
    "cheerio": "1.2.0",
    "classnames": "2.5.1",
    "dataloader": "2.2.3",
    "feedparser": "2.6.0",
    "hono": "4.12.31",
    "intl-messageformat": "11.2.12",
    "js-cookie": "3.0.8",
    "lite-youtube-embed": "0.3.4",
    "lodash": "4.18.1",
    "magic-signatures": "2.0.0",
    "mime": "4.1.0",
    "multiformats": "14.0.5",
    "nanoid": "6.0.0",
    "node-forge": "1.4.0",
    "node-schedule": "2.1.1",
    "pg": "8.22.0",
    "prisma": "7.9.0",
    "pubsubhubbub": "1.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "10.1.18",
    "react-masonry-css": "1.0.16",
    "sanitize-html": "2.17.6",
    "sanitize.css": "13.0.0",
    "swipe-listener": "1.3.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@formatjs/cli": "6.16.14",
    "@formatjs/unplugin": "1.2.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.24",
    "@types/mime": "4.0.0",
    "@types/node": "24.13.3",
    "@types/node-forge": "1.3.14",
    "@types/node-schedule": "2.1.8",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "4.12.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.1.1",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "oxfmt"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "bash -c 'bun run i18n:extract && bun run i18n:compile'"
    ],
    "prisma/schema.prisma": [
      "bun run prisma:generate"
    ]
  },
  "husky": {
    "hooks": {
      "post-checkout": "./scripts/post-checkout",
      "post-merge": "./scripts/post-merge"
    }
  },
  "browserslist": "last 2 versions",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "resolutions": {
    "prosemirror-model": "1.25.11"
  }
}
